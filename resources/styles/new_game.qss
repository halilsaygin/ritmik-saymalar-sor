/* New Game Window Style - Light Theme */
QWidget {
    background-color: #eff1f5;
    color: #4c4f69;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

#headerLabel {
    color: #8839ef;
    font-size: 28px;
    font-weight: bold;
    margin-bottom: 20px;
}

QLabel {
    font-size: 14px;
    color: #5c5f77;
}

/* Form Elements - Simple Styling */
QComboBox, QSpinBox {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 14px;
}

QComboBox::down-arrow {
    image: url(resources/icons/arrow_down.svg);
    width: 10px;
    height: 8px;
}

QComboBox:hover, QSpinBox:hover {
    border: 2px solid #333333;
}

QComboBox:focus, QSpinBox:focus {
    border: 2px solid #000000;
}

/* ComboBox Arrow */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 25px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #0078d7;
    selection-color: #ffffff;
    border: 2px solid #000000;
    border-radius: 5px;
    padding: 5px;
}

/* SpinBox Arrows */
QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
    border: none;
    background-color: transparent;
}

QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QSpinBox::up-arrow {
    image: url(resources/icons/arrow_up.svg);
    width: 8px;
    height: 6px;
}

QSpinBox::down-arrow {
    image: url(resources/icons/arrow_down.svg);
    width: 8px;
    height: 6px;
}

/* Group Box Style */
QGroupBox {
    color: #7287fd;
    font-weight: bold;
    font-size: 16px;
    border: 2px solid #dce0e8;
    border-radius: 12px;
    margin-top: 20px;
    padding-top: 15px; 
    padding-bottom: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px;
}

/* Radio Buttons */
QRadioButton {
    font-size: 14px;
    spacing: 12px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border: 2px solid #dce0e8;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #7287fd;
    border: 4px solid #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #7287fd;
}

/* Start Button */
#btnStart {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #40a02b, stop:1 #209fb5);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 18px;
    font-weight: bold;
    margin-top: 10px;
}

#btnStart:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #7287fd, stop:1 #40a02b);
}

#btnStart:pressed {
    padding-top: 2px;
}
